# ===== OnMyWay FE 환경변수 (react-native-dotenv, @env) =====
# 사용법: cp .env.example .env 후 실제 값 입력 (.env는 절대 커밋 금지)
# 값 변경 후에는 Metro 캐시 리셋 필요: npm start -- --reset-cache

# BE 서버 주소
#  - iOS 시뮬레이터:      http://localhost:3000
#  - Android 에뮬레이터:  http://10.0.2.2:3000
#  - 실기기:              http://{맥북 로컬 IP}:3000
SERVER_BASEURL=http://localhost:3000

# 앱 메타 (네이버지도 앱 딥링크에 사용)
APP_NAME=OnMyWay
ANDROID_PACKAGE_NAME=com.omw.omw_front
IOS_BUNDLE_ID=org.reactjs.native.example.omw-front
