# ===== OnMyWay BE 환경변수 =====
# 사용법: cp .env.example .env 후 실제 값 입력 (.env는 절대 커밋 금지)

# 서버
PORT=3000
MODE=dev                          # dev | prod (Swagger 노출 등 분기)

# Kakao Local API (https://developers.kakao.com → 내 애플리케이션 → REST API 키)
# 형식: "KakaoAK {REST_API_KEY}"
KAKAO_API_KEY=KakaoAK your_kakao_rest_api_key

# OpenAI API (https://platform.openai.com/api-keys)
# 형식: "Bearer sk-..."
OPENAI_HEADER_AUTH=Bearer sk-your_openai_api_key

# Swagger (/docs) basic auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_me
